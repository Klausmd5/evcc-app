+                activity,
+                new KeyChainAliasCallback() {
+                    @Override
+                    public void alias(final String alias) {
+                        if (alias == null) {
+                            Log.w(TAG, "Client certificate selection cancelled.");
+                            request.cancel();
+                            return;
+                        }
+                        new Thread(() -> {
+                            try {
+                                PrivateKey privateKey = KeyChain.getPrivateKey(activity, alias);
+                                X509Certificate[] chain = KeyChain.getCertificateChain(activity, alias);
+                                if (privateKey != null && chain != null) {
+                                    request.proceed(privateKey, chain);
+                                } else {
+                                    Log.w(TAG, "Client certificate missing key or chain.");
+                                    request.cancel();
+                                }
+                            } catch (Exception e) {
+                                Log.e(TAG, "Failed to provide client certificate", e);
+                                request.cancel();
+                            }
