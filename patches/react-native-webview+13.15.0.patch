+    public void onReceivedClientCertRequest(final WebView view, final ClientCertRequest request) {
+        Log.i(TAG, "onReceivedClientCertRequest");
+        Activity activity = null;
+        if (view.getContext() instanceof ThemedReactContext) {
+            activity = ((ThemedReactContext) view.getContext()).getCurrentActivity();
+        }
+
+        if (activity == null) {
+            Log.w(TAG, "Client certificate request without activity, cancelling.");
+            request.cancel();
+            return;
+        }
+
